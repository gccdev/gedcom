# Neon Postgres (get from neon.tech dashboard)
DATABASE_URL=

# Auth.js secret (generate with: openssl rand -base64 32)
AUTH_SECRET=

# Resend API key (get from resend.com)
AUTH_RESEND_KEY=
RESEND_FROM=Family Tree <noreply@yourdomain.com>

# Who may sign in: comma-separated email addresses. Required — when unset or
# empty nobody can sign in. Set it in Vercel too (Production and Preview).
AUTH_ALLOWED_EMAILS=

# Vercel Blob token (get from vercel.com dashboard → Storage → Blob)
BLOB_READ_WRITE_TOKEN=

# Default tree starting person (set after import — use any GEDCOM individual ID, e.g. I1)
DEFAULT_ROOT_PERSON_ID=13082800

# Local-only login bypass for manual QA. Skips all session checks.
# Inert whenever VERCEL is set, and only active under `npm run dev` / `npm start`,
# which bind the server to 127.0.0.1 and set AUTH_BYPASS_BIND=loopback. Note `vercel env pull` writes VERCEL="1" into
# .env.local, which disables the bypass on that machine until the line is removed.
# AUTH_DEV_BYPASS=true
